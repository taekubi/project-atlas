{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSlackSigningSecret",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:714933490352:parameter/project-atlas/slack/signing-secret"
      ]
    },
    {
      "Sid": "DecryptSlackSigningSecret",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": [
        "arn:aws:kms:ap-northeast-2:714933490352:key/990aae36-fd29-4a37-85a2-9b62e8c6555d"
      ]
    },
    {
      "Sid": "InvokeDbHealthJobFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-2:714933490352:function:project-atlas-slack-db-health-job"
      ]
    }
  ]
}
