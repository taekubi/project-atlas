{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAtlasConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::project-atlas-data-714933490352-ap-northeast-2/config/atlas.toml"
      ]
    },
    {
      "Sid": "ReadCuratedCloudWatchData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::project-atlas-data-714933490352-ap-northeast-2/curated/cloudwatch/*"
      ]
    },
    {
      "Sid": "ListAtlasDataBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::project-atlas-data-714933490352-ap-northeast-2"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "curated/cloudwatch/*",
            "athena-results/*"
          ]
        }
      }
    },
    {
      "Sid": "VerifyAthenaOutputBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::project-atlas-data-714933490352-ap-northeast-2"
      ]
    },
    {
      "Sid": "ReadWriteAthenaResults",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::project-atlas-data-714933490352-ap-northeast-2/athena-results/*"
      ]
    },
    {
      "Sid": "RunAthenaQueries",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution"
      ],
      "Resource": [
        "arn:aws:athena:ap-northeast-2:714933490352:workgroup/primary"
      ]
    },
    {
      "Sid": "ReadGlueCatalogForAthena",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:ap-northeast-2:714933490352:catalog",
        "arn:aws:glue:ap-northeast-2:714933490352:database/project_atlas",
        "arn:aws:glue:ap-northeast-2:714933490352:table/project_atlas/cloudwatch_metrics"
      ]
    },
    {
      "Sid": "InvokeBedrockClaudeModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:ap-northeast-2:714933490352:inference-profile/apac.anthropic.claude-3-5-sonnet-20241022-v2:0",
        "arn:aws:bedrock:ap-northeast-1::foundation-model/anthropic.claude-3-5-sonnet-20241022-v2:0",
        "arn:aws:bedrock:ap-northeast-2::foundation-model/anthropic.claude-3-5-sonnet-20241022-v2:0",
        "arn:aws:bedrock:ap-southeast-1::foundation-model/anthropic.claude-3-5-sonnet-20241022-v2:0",
        "arn:aws:bedrock:ap-southeast-2::foundation-model/anthropic.claude-3-5-sonnet-20241022-v2:0"
      ]
    }
  ]
}
