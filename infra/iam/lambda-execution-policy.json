{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRdsCloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteAndVerifyCloudWatchRawData",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::project-atlas-data-714933490352-ap-northeast-2/raw/cloudwatch/*"
      ]
    }
  ]
}