{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRdsCloudWatchMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DescribeRdsResources",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadPerformanceInsightsTopSql",
      "Effect": "Allow",
      "Action": [
        "pi:DescribeDimensionKeys"
      ],
      "Resource": "*"
    }
  ]
}